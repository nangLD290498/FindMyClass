{
  "name": "findmyclass-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html",
